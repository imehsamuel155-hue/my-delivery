{
  "hosting": {
    "public": "public",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "/were",
        "destination": "/were.html"
      },
      {
        "source": "/admin",
        "destination": "/admin.html"
      },
      {
        "source": "/board",
        "destination": "/board.html"
      },
      {
        "source": "/chat",
        "destination": "/chat.html"
      },
      {
        "source": "/receipt",
        "destination": "/receipt.html"
      },
      {
        "source": "/box",
        "destination": "/box.html"
      }
    ]
  }
}