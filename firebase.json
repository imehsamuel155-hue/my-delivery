{
    "hosting": {
        "public": "public",
        "ignore": [
            "firebase.json",
            "**/.*",
            "**/node_modules/**"
        ],
        "rewrites": [
            {
                "source": "/admin",
                "destination": "/admin.html"
            },
            {
                "source": "/receipt",
                "destination": "/receipt.html"
            },
            {
                "source": "/box",
                "destination": "/box.html"
            },
            {
                "source": "/track",
                "destination": "/index.html"
            }
        ]
    }
}