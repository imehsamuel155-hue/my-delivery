{
  "hosting": {
    "public": "public",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "admin.html",
      "board.html"
    ],
    "rewrites": [
      {
        "source": "/receipt",
        "destination": "/receipt.html"
      },
      {
        "source": "/box",
        "destination": "/box.html"
      },
      {
        "source": "/track",
        "destination": "/index.html"
      },
      {
        "source": "/admin",
        "destination": "/index.html"
      },
      {
        "source": "/admin/**",
        "destination": "/index.html"
      }
    ]
  }
}